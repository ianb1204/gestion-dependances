{
  "name": "tp-api-meteo",
  "version": "2.0.0",
  "description": "API Météo avec Inversion de Contrôle (IoC), Injection de Dépendances (DI) et Multi-Fournisseurs (TP1 & TP2)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:contract": "vitest run tests/contract",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest"
  },
  "keywords": [
    "ioc",
    "dependency-injection",
    "express",
    "weather-api",
    "open-meteo",
    "nominatim",
    "ban",
    "base-adresse-nationale",
    "met-norway",
    "contract-tests"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^18.0.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "vitest": "^3.2.7"
  }
}
